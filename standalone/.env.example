# Kopieren nach .env und ausfüllen. Die .env gehört nicht ins Git.
#
# Passwörter erzeugen:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
# Sonderzeichen bewusst entfernt: Das DB-Passwort landet in Verbindungsstrings,
# in denen @ und # die URL zerlegen würden.

# Domain, unter der LimeSurvey erreichbar ist - ohne https://
HOST=example.com

# Zugangsdaten des ersten Administrators (nur bei der Erstinstallation wirksam)
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Datenbankpasswort, wird von beiden Containern verwendet
POSTGRES_PASSWORD=
